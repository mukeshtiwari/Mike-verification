    elliptic.x_point.PointX.coords fp2traitsFp2Inst.FqInst P4
  let n_alpha ←
    gluing.scholten_gluing.fp2_norm fp2traitsFqInst fp2traitsFp2Inst alpha
  let n_beta ←
    gluing.scholten_gluing.fp2_norm fp2traitsFqInst fp2traitsFp2Inst beta
  let m0 ← fp2traitsFqInst.coreopsarithAddInst.add n_alpha n_beta
  let m2 ← fp2traitsFqInst.coreopsarithSubInst.sub n_beta n_alpha
  let t ← fp2traitsFp2Inst.conjugate beta
