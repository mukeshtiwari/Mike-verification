    Source: 'src/gluing/scholten_gluing.rs', lines 144:0-165:1 -/
def gluing.scholten_gluing.scholten_constants_precomputation
  {Fp : Type} {Clause0_Encoded : Type} (fp2traitsFqInst : fp2.traits.Fq Fp
  Clause0_Encoded) (mi : Array Fp 4#usize) :
  Result (Array Fp 5#usize)
  := do
  let m0 ← Array.index_usize mi 0#usize
  let m1 ← Array.index_usize mi 1#usize
  let m2 ← Array.index_usize mi 2#usize
  let m3 ← Array.index_usize mi 3#usize
  let m0_sqr ← fp2traitsFqInst.square m0
  let m1_sqr ← fp2traitsFqInst.square m1
  let m2_sqr ← fp2traitsFqInst.square m2
  let m3_sqr ← fp2traitsFqInst.square m3
  let t ← fp2traitsFqInst.coreopsarithSubInst.sub m0_sqr m3_sqr
  let t1 ← fp2traitsFqInst.coreopsarithAddInst.add m1_sqr m2_sqr
  let left_val ← fp2traitsFqInst.equals t t1
  massert (left_val = core.num.U32.MAX)
  let b ← fp2traitsFqInst.coreopsarithSubInst.sub m0_sqr m1_sqr
  let c ← fp2traitsFqInst.coreopsarithSubInst.sub m0_sqr m2_sqr
  let t2 ← fp2traitsFqInst.coreopsarithMulInst.mul m0 m1
  let d ← fp2traitsFqInst.mul4 t2
  let t3 ← fp2traitsFqInst.coreopsarithMulInst.mul m2 m3
  let e ← fp2traitsFqInst.mul4 t3
  ok (Array.make 5#usize [ t1, b, c, d, e ])

