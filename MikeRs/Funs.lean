def mike.mike_impl.Mike.clamp_scalar_bytes
  {Fp : Type} {Fp2 : Type} {Clause0_Encoded : Type} {Clause1_BaseField : Type}
  {Clause1_Clause0_Encoded : Type} {Clause1_Clause1_Clause0_Encoded : Type}
  {Clause1_Clause2_Clause0_Encoded : Type} {Clause1_Clause3_Clause0_Encoded :
  Type} {Clause1_Clause4_Encoded : Type} {N : Std.Usize} (fp2traitsFqInst :
  fp2.traits.Fq Fp Clause0_Encoded) (fp2traitsFp2Inst : fp2.traits.Fp2 Fp2
  Clause1_BaseField Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded)
  (self : mike.mike_impl.Mike Fp Fp2 Clause0_Encoded Clause1_BaseField
  Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded N) (scalar : Array Std.U8 N) :
  Result (Array Std.U8 N)
  := do
  let remainder ← self.params.constants.e % 8#usize
  let scalar1 ←
    if remainder != 0#usize
    then
      do
      let i ← 1#u8 <<< remainder
      let i1 ← i - 1#u8
      let i2 ← N - 1#usize
      let i3 ← Array.index_usize scalar i2
      let i4 ← lift (i3 &&& i1)
      Array.update scalar i2 i4
    else ok scalar
  let i ← Array.index_usize scalar1 0#usize
  let i1 ← lift (~~~ 7#u8)
  let i2 ← lift (i &&& i1)
  let i3 ← lift (i2 ||| 3#u8)
  Array.update scalar1 0#usize i3

