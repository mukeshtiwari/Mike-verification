def mike.mike_impl.MikePrivateKey.generate_kernel_elements
  {Fp : Type} {Fp2 : Type} {Clause0_Encoded : Type} {Clause1_Clause0_Encoded :
  Type} {Clause1_Clause1_Clause0_Encoded : Type}
  {Clause1_Clause2_Clause0_Encoded : Type} {Clause1_Clause3_Clause0_Encoded :
  Type} {Clause1_Clause4_Encoded : Type} {N : Std.Usize} (fp2traitsFqInst :
  fp2.traits.Fq Fp Clause0_Encoded) (fp2traitsFp2Inst : fp2.traits.Fp2 Fp2 Fp
  Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded)
  (self : mike.mike_impl.MikePrivateKey Fp Fp2 Clause0_Encoded Fp
  Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded N)
  (curve : elliptic.curve.Curve Fp2 Clause1_Clause0_Encoded)
  (a_div_three : Fp2) :
  Result ((mike.mike_impl.KernelPoints Fp2 Fp Clause1_Clause0_Encoded
    Clause1_Clause1_Clause0_Encoded Clause1_Clause2_Clause0_Encoded
    Clause1_Clause3_Clause0_Encoded Clause1_Clause4_Encoded) × (Array (Array
    (elliptic.jac_point.Point Fp2 Clause1_Clause0_Encoded) 2#usize) 2#usize))
  := do
  let i ← self.constants.e + 2#usize
  let e_diff ← self.constants.f - i
  let cofactor_bytes ← lift (core.num.Usize.to_le_bytes self.constants.c)
  let i1 ← lift (core.num.Usize.leading_zeros self.constants.c)
  let i2 ← core.num.Usize.BITS - i1
  let cofactor_bits ← lift (UScalar.cast .Usize i2)
  let s ← lift (Array.to_slice cofactor_bytes)
  let basis ←
    elliptic.torsion_basis.Curve.torsion_basis_2e_vartime fp2traitsFp2Inst
      curve e_diff s cofactor_bits
  let (P, Q) ←
    elliptic.torsion_basis.Curve.lift_to_jacobian fp2traitsFp2Inst curve basis
  let s1 ← lift (Array.to_slice self.secret)
  let s_P ←
    elliptic.jac_arithmetic.Curve.mul fp2traitsFp2Inst.FqInst curve P s1
      1#usize self.constants.e
  let s2 ← lift (Array.to_slice self.secret)
  let s_Q ←
    elliptic.jac_arithmetic.Curve.mul fp2traitsFp2Inst.FqInst curve Q s2
      1#usize self.constants.e
  let T1 ←
    elliptic.jac_arithmetic.Curve.add fp2traitsFp2Inst.FqInst curve s_Q Q
  let T3 ←
    elliptic.jac_arithmetic.Curve.add fp2traitsFp2Inst.FqInst curve s_P P
  let p ←
    elliptic.jac_point.Point.Insts.CoreOpsArithNegPoint.neg
      fp2traitsFp2Inst.FqInst T3
  let p1 ←
    elliptic.jac_point.Point.Insts.CoreOpsArithNegPoint.neg
      fp2traitsFp2Inst.FqInst s_P
  let i3 ← self.constants.e - 3#usize
  let P_32 ←
    elliptic.jac_arithmetic.Curve.double_iter_with_ws fp2traitsFp2Inst.FqInst
      curve P a_div_three i3
  let Q_32 ←
    elliptic.jac_arithmetic.Curve.double_iter_with_ws fp2traitsFp2Inst.FqInst
      curve Q a_div_three i3
  let s3 ← lift (Array.to_slice self.secret)
  let s_P_32 ←
    elliptic.jac_arithmetic.Curve.mul fp2traitsFp2Inst.FqInst curve P_32 s3
      1#usize 6#usize
  let s4 ← lift (Array.to_slice self.secret)
  let s_Q_32 ←
    elliptic.jac_arithmetic.Curve.mul fp2traitsFp2Inst.FqInst curve Q_32 s4
      1#usize 6#usize
  let T11 ←
    elliptic.jac_arithmetic.Curve.add fp2traitsFp2Inst.FqInst curve s_Q_32 Q_32
  let T31 ←
    elliptic.jac_arithmetic.Curve.add fp2traitsFp2Inst.FqInst curve s_P_32 P_32
  let T4 ←
    elliptic.jac_arithmetic.Curve.sub fp2traitsFp2Inst.FqInst curve T11 T31
  let T5 ←
    elliptic.jac_arithmetic.Curve.sub fp2traitsFp2Inst.FqInst curve s_Q_32
      s_P_32
  let p2 ←
    elliptic.jac_point.Point.Insts.CoreOpsArithNegPoint.neg
      fp2traitsFp2Inst.FqInst T31
  let p3 ←
    elliptic.jac_point.Point.Insts.CoreOpsArithNegPoint.neg
      fp2traitsFp2Inst.FqInst s_P_32
  let P_16 ←
    elliptic.jac_arithmetic.Curve.double fp2traitsFp2Inst.FqInst curve P_32
  let Q_16 ←
    elliptic.jac_arithmetic.Curve.double fp2traitsFp2Inst.FqInst curve Q_32
  let P_8 ←
    elliptic.jac_arithmetic.Curve.double fp2traitsFp2Inst.FqInst curve P_16
  let Q_8 ←
    elliptic.jac_arithmetic.Curve.double fp2traitsFp2Inst.FqInst curve Q_16
  ok
    ({
       scholten_kernel := (Array.make 2#usize [ P_8, Q_8 ]),
       diagonal_kernel := (Array.make 2#usize [ Q_16, P_16 ]),
       gluing_kernel :=
         (Array.make 3#usize [
           Array.make 2#usize [ T11, s_Q_32 ], Array.make 2#usize [ p2, p3 ],
           Array.make 2#usize [ T4, T5 ]
           ])
     },
    Array.make 2#usize [
      Array.make 2#usize [ T1, s_Q ], Array.make 2#usize [ p, p1 ]
      ])

