  let t12 ← fp2traitsFqInst.square t01
  let t29 ← fp2traitsFqInst.square dx1
  let t3 ← fp2traitsFqInst.square dy1
  let XR ← fp2traitsFqInst.coreopsarithMulInst.mul self.A t12
  let XR1 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign XR u1
  let XR2 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign XR1 u2
  let XR3 ← fp2traitsFqInst.coreopsarithMulAssignInst.mul_assign XR2 t29
  let XR4 ← fp2traitsFqInst.coreopsarithSubInst.sub t3 XR3
  let YR ← fp2traitsFqInst.coreopsarithMulInst.mul u1 t29
  let YR1 ← fp2traitsFqInst.coreopsarithSubAssignInst.sub_assign YR XR4
  let YR2 ← fp2traitsFqInst.coreopsarithMulAssignInst.mul_assign YR1 dy1
  let t31 ← fp2traitsFqInst.coreopsarithMulInst.mul dx1 t29
  let t32 ← fp2traitsFqInst.coreopsarithMulInst.mul t31 v11
  let YR3 ← fp2traitsFqInst.coreopsarithSubAssignInst.sub_assign YR2 t32
  let ZR ← fp2traitsFqInst.coreopsarithMulInst.mul dx1 t01
