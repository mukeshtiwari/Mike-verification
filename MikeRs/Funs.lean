def elliptic.jac_arithmetic.Curve.set_rand_point
  {Fq : Type} {R : Type} {Clause0_Encoded : Type} {Clause1_Clause0_Encoded :
  Type} (fp2traitsFqInst : fp2.traits.Fq Fq Clause0_Encoded)
  (fp2traitsFqRndInst : fp2.traits.FqRnd Fq Clause1_Clause0_Encoded)
  (rand_coreCryptoRngInst : rand_core.CryptoRng R) (rand_coreRngCoreInst :
  rand_core.RngCore R) (self : elliptic.curve.Curve Fq Clause0_Encoded)
  (rng : R) (P : elliptic.jac_point.Point Fq Clause0_Encoded) :
  Result (R × (elliptic.jac_point.Point Fq Clause0_Encoded))
  := do
  let t ← fp2traitsFqInst.ONE
  let (rng1, t1, t2) ←
    elliptic.jac_arithmetic.Curve.set_rand_point_loop fp2traitsFqInst
      fp2traitsFqRndInst rand_coreCryptoRngInst rand_coreRngCoreInst self rng
      P.X P.Y
  let (_, t3) ← fp2traitsFqInst.set_sqrt t2
  let tmp := Array.repeat 1#usize 0#u8
  let (s, to_slice_mut_back) ← lift (Array.to_slice_mut tmp)
  let (rng2, s1) ← rand_coreRngCoreInst.fill_bytes rng1 s
  let tmp1 := to_slice_mut_back s1
  let i ← Array.index_usize tmp1 0#usize
  let i1 ← lift (UScalar.cast .U32 i)
  let i2 ← lift (i1 &&& 1#u32)
  let ctl ← lift (core.num.U32.wrapping_sub 0#u32 i2)
  let t4 ← fp2traitsFqInst.set_cond_neg t3 ctl
  ok (rng2, { X := t1, Y := t4, Z := t })

