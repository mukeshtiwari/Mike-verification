def gluing.scholten_gluing.scholten_j_precomputation
  {Fp : Type} {Fp2 : Type} {Clause0_Encoded : Type} {Clause1_Clause0_Encoded :
  Type} {Clause1_Clause1_Clause0_Encoded : Type}
  {Clause1_Clause2_Clause0_Encoded : Type} {Clause1_Clause3_Clause0_Encoded :
  Type} {Clause1_Clause4_Encoded : Type} (fp2traitsFqInst : fp2.traits.Fq Fp
  Clause0_Encoded) (fp2traitsFp2Inst : fp2.traits.Fp2 Fp2 Fp
  Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded) (mi : Array Fp 4#usize)
  (P8 : elliptic.jac_point.Point Fp2 Clause1_Clause0_Encoded)
  (Q8 : elliptic.jac_point.Point Fp2 Clause1_Clause0_Encoded) :
  Result (theta.dim_two.ThetaPointDimTwo Fp Clause0_Encoded)
  := do
  let T1 ←
    gluing.scholten_gluing.point_to_squared_theta_point fp2traitsFqInst
      fp2traitsFp2Inst mi P8
  let T2 ←
    gluing.scholten_gluing.point_to_squared_theta_point fp2traitsFqInst
      fp2traitsFp2Inst mi Q8
  let T11 ← theta.dim_two.ThetaPointDimTwo.set_hadamard fp2traitsFqInst T1
  let T21 ← theta.dim_two.ThetaPointDimTwo.set_hadamard fp2traitsFqInst T2
  let (xA, _, yC, yD) ←
    theta.dim_two.ThetaPointDimTwo.coords fp2traitsFqInst T11
  let (zA, _, zY, tD) ←
    theta.dim_two.ThetaPointDimTwo.coords fp2traitsFqInst T21
  let left_val ← fp2traitsFqInst.is_zero yD
  massert (left_val = core.num.U32.MAX)
  let left_val1 ← fp2traitsFqInst.is_zero tD
  massert (left_val1 = core.num.U32.MAX)
  let x ← fp2traitsFqInst.coreopsarithMulInst.mul xA zY
  let y ← fp2traitsFqInst.coreopsarithMulInst.mul yC zA
  theta.dim_two.ThetaPointDimTwo.new fp2traitsFqInst y y x x

