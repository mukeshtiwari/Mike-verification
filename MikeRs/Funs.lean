def elliptic.curve.Curve.new
  {Fq : Type} {Clause0_Encoded : Type} (fp2traitsFqInst : fp2.traits.Fq Fq
  Clause0_Encoded) (A : Fq) :
  Result ((elliptic.curve.Curve Fq Clause0_Encoded) × Std.U32)
  := do
  let t ← fp2traitsFqInst.TWO
