  := do
  let px ← elliptic.jac_point.Point.to_point_x fp2traitsFp2Inst.FqInst p4
  let E_normalized ←
    elliptic.two_isogeny_chain.Curve.normalize_curve fp2traitsFp2Inst px
  let i ← fp2traitsFp2Inst.FqInst.equals domain.A E_normalized.A
  if i = core.num.U32.MAX
  then ok (core.result.Result.Ok ())
  else
    ok (core.result.Result.Err mike.mike_impl.MikeError.NonCanonicalPublicKey)

