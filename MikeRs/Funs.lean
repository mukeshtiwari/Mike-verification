  let ctl_2 ← fp2traitsFqInst.is_zero Q.Z
  let t0 ← fp2traitsFqInst.square P.Z
  let t1 ← fp2traitsFqInst.square Q.Z
  let v1 ← fp2traitsFqInst.coreopsarithMulInst.mul t1 Q.Z
  let t2 ← fp2traitsFqInst.coreopsarithMulInst.mul t0 P.Z
  let v11 ← fp2traitsFqInst.coreopsarithMulInst.mul v1 P.Y
  let t21 ← fp2traitsFqInst.coreopsarithMulInst.mul t2 Q.Y
  let dy ← fp2traitsFqInst.coreopsarithSubInst.sub t21 v11
  let u2 ← fp2traitsFqInst.coreopsarithMulInst.mul t0 Q.X
  let u1 ← fp2traitsFqInst.coreopsarithMulInst.mul t1 P.X
  let dx ← fp2traitsFqInst.coreopsarithSubInst.sub u2 u1
  let t11 ← fp2traitsFqInst.coreopsarithAddInst.add P.Y P.Y
