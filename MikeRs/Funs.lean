  let t12 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign t11 t53
  let t13 ← fp2traitsFqInst.coreopsarithMulAssignInst.mul_assign t12 t63
  let u ← fp2traitsFqInst.coreopsarithSubInst.sub t43 t13
  let w ← fp2traitsFqInst.coreopsarithMulInst.mul t63 t01
