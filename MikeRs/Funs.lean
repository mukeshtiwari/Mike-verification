  let t0 ← fp2traitsFp2Inst.FqInst.mul2 t1
  let m1 ← fp2traitsFp2Inst.x0 t0
  let m3 ← fp2traitsFp2Inst.x1 t0
  ok (Array.make 4#usize [ m0, m1, m2, m3 ])

