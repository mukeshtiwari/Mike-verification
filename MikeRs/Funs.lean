def gluing.scholten_gluing.point_to_squared_theta_point
  {Fp : Type} {Fp2 : Type} {Clause0_Encoded : Type} {Clause1_Clause0_Encoded :
  Type} {Clause1_Clause1_Clause0_Encoded : Type}
  {Clause1_Clause2_Clause0_Encoded : Type} {Clause1_Clause3_Clause0_Encoded :
  Type} {Clause1_Clause4_Encoded : Type} (fp2traitsFqInst : fp2.traits.Fq Fp
  Clause0_Encoded) (fp2traitsFp2Inst : fp2.traits.Fp2 Fp2 Fp
  Clause1_Clause0_Encoded Clause1_Clause1_Clause0_Encoded
  Clause1_Clause2_Clause0_Encoded Clause1_Clause3_Clause0_Encoded
  Clause1_Clause4_Encoded) (mi : Array Fp 4#usize)
  (P : elliptic.jac_point.Point Fp2 Clause1_Clause0_Encoded) :
  Result (theta.dim_two.ThetaPointDimTwo Fp Clause0_Encoded)
  := do
  let px ← elliptic.jac_point.Point.to_point_x fp2traitsFp2Inst.FqInst P
  let (x, z) ← elliptic.x_point.PointX.coords fp2traitsFp2Inst.FqInst px
  let m0 ← Array.index_usize mi 0#usize
  let m1 ← Array.index_usize mi 1#usize
  let m2 ← Array.index_usize mi 2#usize
  let m3 ← Array.index_usize mi 3#usize
  let n_x ←
    gluing.scholten_gluing.fp2_norm fp2traitsFqInst fp2traitsFp2Inst x
  let n_z ←
    gluing.scholten_gluing.fp2_norm fp2traitsFqInst fp2traitsFp2Inst z
  let t ← fp2traitsFp2Inst.conjugate z
  let t1 ← fp2traitsFp2Inst.FqInst.coreopsarithMulInst.mul x t
  let tmp ← fp2traitsFp2Inst.FqInst.mul2 t1
  let t0 ← fp2traitsFqInst.coreopsarithAddInst.add n_x n_z
  let t11 ← fp2traitsFqInst.coreopsarithSubInst.sub n_x n_z
  let t2 ← fp2traitsFp2Inst.x0 tmp
  let t3 ← fp2traitsFp2Inst.x1 tmp
  let t4 ← fp2traitsFqInst.coreopsarithMulInst.mul m0 t0
  let t5 ← fp2traitsFqInst.coreopsarithMulInst.mul m1 t2
  let X ← fp2traitsFqInst.coreopsarithSubInst.sub t4 t5
  let t6 ← fp2traitsFqInst.coreopsarithMulInst.mul m0 t2
  let t7 ← fp2traitsFqInst.coreopsarithMulInst.mul m1 t0
  let Y ← fp2traitsFqInst.coreopsarithSubInst.sub t6 t7
  let t8 ← fp2traitsFqInst.coreopsarithMulInst.mul m2 t11
  let t9 ← fp2traitsFqInst.coreopsarithMulInst.mul m3 t3
  let Z ← fp2traitsFqInst.coreopsarithSubInst.sub t8 t9
  let t10 ← fp2traitsFqInst.coreopsarithMulInst.mul m2 t3
  let t12 ← fp2traitsFqInst.coreopsarithMulInst.mul m3 t11
  let T ← fp2traitsFqInst.coreopsarithAddInst.add t10 t12
  let X1 ← fp2traitsFqInst.set_square X
  let Y1 ← fp2traitsFqInst.set_square Y
  let Z1 ← fp2traitsFqInst.set_square Z
  let T1 ← fp2traitsFqInst.set_square T
  let T2 ← fp2traitsFqInst.set_neg T1
  theta.dim_two.ThetaPointDimTwo.new fp2traitsFqInst X1 Y1 Z1 T2

