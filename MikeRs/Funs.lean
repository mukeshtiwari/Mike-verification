  let t22 ← fp2traitsFqInst.mul2 t
  let t23 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign t22 t0
  let t24 ← fp2traitsFqInst.coreopsarithMulAssignInst.mul_assign t23 t0
  let t0_sq ← fp2traitsFqInst.square P.X
  let t25 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign t24 t0_sq
  let t26 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign t25 t0_sq
  let t27 ← fp2traitsFqInst.coreopsarithAddAssignInst.add_assign t26 t0_sq
  let t28 ← fp2traitsFqInst.coreopsarithMulInst.mul t27 Q.Z
  let i ← fp2traitsFqInst.is_zero dx
  let i1 ← fp2traitsFqInst.is_zero dy
  let ctl ← lift (i &&& i1)
  let dx1 ← fp2traitsFqInst.set_cond dx t11 ctl
  let dy1 ← fp2traitsFqInst.set_cond dy t28 ctl
